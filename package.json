{
  "name": "pi-taskmesh",
  "version": "0.7.0",
  "description": "Task-aware adaptive multi-model orchestration for Pi with optional Jev judgments",
  "type": "module",
  "main": "extensions/index.ts",
  "bin": {
    "pi-jev-gate": "./bin/jev-gate.js",
    "jev-gate": "./bin/jev-gate.js"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "typesafe",
    "vercel",
    "ai-gateway",
    "jev",
    "system-one",
    "tool-router"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit false --outDir .test-build && node .test-build/test/persistence.js && node .test-build/test/orchestration.js",
    "test:native": "tsc --noEmit false --outDir .test-build && node test/native-workflow.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "optionalDependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "^22.0.0",
    "@sinclair/typebox": "^0.34.28",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x1f/pi-taskmesh.git"
  },
  "bugs": {
    "url": "https://github.com/0x1f/pi-taskmesh/issues"
  },
  "homepage": "https://github.com/0x1f/pi-taskmesh#readme",
  "author": "0x1f; based on pi-jev by Theophilo Damiao",
  "license": "MIT"
}
